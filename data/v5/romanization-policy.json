{
  "version": "learner-roman-v1",
  "purpose": "Consistent ASCII learner-facing Romanization for modern Iranian Persian.",
  "principles": [
    "Romanize the Persian form actually shown on the card.",
    "Use spokenRoman or formalRoman only for an alternate spokenFa/formalFa form; roman always belongs to the primary fa form.",
    "Use simple ASCII spellings intended to cue pronunciation, not academic transliteration.",
    "Use aa for the long a sound, i for the long i sound, and oo for the long u sound.",
    "Use kh, gh, sh, ch, and zh consistently.",
    "Use gh for modern Iranian Persian ق and غ unless a fixed loanword spelling is clearer.",
    "Do not use diacritics, apostrophes, underscores, or hyphens in learner-facing Romanization.",
    "Use spaces for word boundaries and keep punctuation limited to ordinary learner cues such as ? and !."
  ],
  "forbiddenPatterns": [
    {"pattern":"'","reason":"apostrophes are unnecessary for the learner-facing scheme"},
    {"pattern":"-","reason":"use spaces rather than hyphens in learner-facing Romanization"}
  ],
